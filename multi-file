// app/globals.css
:root {
--radius: 6px;
--mobile-nav-height: 56px;
}

@layer utilities {
.pb-safe-nav {
  padding-bottom: calc(var(--mobile-nav-height) + env(safe-area-inset-bottom, 0px));
}

.pb-safe-area {
  padding-bottom: env(safe-area-inset-bottom, 0px);
}
}

// app/page.tsx
import { useRef, useEffect } from 'react';

const Page = ({ activeSection }) => {
const mobileNavRef = useRef<HTMLElement | null>(null);

useEffect(() => {
  const updateNavHeight = () => {
    const h = mobileNavRef.current?.offsetHeight ?? 0;
    document.documentElement.style.setProperty("--mobile-nav-height", `${h}px`);
  };
  updateNavHeight();
  window.addEventListener("resize", updateNavHeight);
  return () => window.removeEventListener("resize", updateNavHeight);
}, []);

return (
  <div>
    <nav ref={mobileNavRef} className="fixed bottom-0 left-0 right-0 z-50 md:hidden">
      <div className="flex items-center justify-around px-2 py-2 gap-2 pb-safe-area">
        {/* Mobile nav items here */}
      </div>
    </nav>
    <main
      className={`transition-all duration-500 ease-in-out pt-0 sm:pt-8 md:pt-16 pb-safe-nav md:pb-0 ${activeSection === "home" ? "" : "md:pb-4"}`}
    >
      {/* Main content here */}
    </main>
  </div>
);
};

export default Page;
